# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://sso.farismnrr.com/auth/github/callback
# Optional overrides for deterministic E2E or GitHub-compatible providers.
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_URL=https://api.github.com/
ALLOWED_GITHUB_USER_IDS=120432426

# SSO service
SSO_BASE_URL=https://sso.farismnrr.com
SSO_PORT=3000

# Session
SESSION_SECRET=
SESSION_TTL_SECONDS=604800

# Trusted Relay connection handoff
RELAY_CALLBACK_URL=https://relay.example.com/connections/callback
RELAY_AUDIENCE=relay-agent
RELAY_ASSERTION_SECRET=
RELAY_ASSERTION_TTL_SECONDS=90

# Development UI inspector
AGENTATION_ENABLED=false
