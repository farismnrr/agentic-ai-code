# Copy to .env and fill in the values for your machine. .env is gitignored.

# Dev server port. 3000/3001/3004/3100 are taken on the original dev machine,
# so nuxt.config.ts defaults devServer.port to 3333.
NUXT_PORT=3333

# Dev server bind address. Unset = localhost only (safe default).
#
# To reach the dev server from another device, bind to a specific interface —
# NOT 0.0.0.0, which also exposes it to whatever Wi-Fi/LAN you're on.
#   tailscale ip -4
# NUXT_HOST=

# Public runtime config — exposed to the browser.
NUXT_PUBLIC_SITE_URL=http://localhost:3333

# ---------------------------------------------------------------------------
# Router (plan 007)
# ---------------------------------------------------------------------------
NUXT_ROUTER_BASE_URL=http://localhost:20128/v1
NUXT_ROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Model providers (plan 023 — user-configurable providers/models)
# ---------------------------------------------------------------------------
# AES-256-GCM key used to encrypt provider API keys at rest. Must be a
# 32-byte hex string. Generate with: openssl rand -hex 32
NUXT_MODEL_PROVIDER_SECRET_KEY=

# ---------------------------------------------------------------------------
# Workspaces (plan 010)
# ---------------------------------------------------------------------------
NUXT_WORKSPACES_ROOT=

# ---------------------------------------------------------------------------
# Public remote MCP relay (plan 036)
# ---------------------------------------------------------------------------
# Exact first-party MCP resource. When a stored HTTP MCP server has this exact
# URL, Nitro attaches the private access token below. The token is never part
# of public runtime config and never round-trips through the MCP settings API.
# Production target:
# NUXT_REMOTE_MCP_URL=https://mcp.farismunir.my.id/mcp
NUXT_REMOTE_MCP_URL=
# Raw OAuth access token for the resource above (do not include "Bearer ").
# Obtain/rotate this through the selected external Authorization Server. This
# is the server-side Nuxt credential path; ChatGPT performs its own OAuth flow.
NUXT_REMOTE_MCP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Database (plan 005)
# ---------------------------------------------------------------------------
NUXT_DATABASE_URL=
# Only used by docker-compose.yml (plan 022) — overrides NUXT_DATABASE_URL
# inside the container, since "localhost" there means the container itself,
# not the host machine. Point this at the same Postgres via
# host.docker.internal, same credentials as NUXT_DATABASE_URL above.
NUXT_DATABASE_URL_DOCKER=

# ---------------------------------------------------------------------------
# Session (plan 005 — nuxt-auth-utils sealed cookie)
# ---------------------------------------------------------------------------
# Must be >= 32 characters. Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# ---------------------------------------------------------------------------
# SMTP (plan 005 — email verification + password reset)
# ---------------------------------------------------------------------------
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
NUXT_SMTP_SECURE=
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_FROM=

# ---------------------------------------------------------------------------
# OAuth (plan 005 phase 2 — Google + GitHub)
# ---------------------------------------------------------------------------
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Telemetry (plan 022)
# ---------------------------------------------------------------------------
NUXT_OTEL_ENABLED=false
NUXT_OTEL_SERVICE_NAME=ai-code
NUXT_OTEL_JAEGER_ENDPOINT=http://localhost:4317
NUXT_OTEL_LOKI_PUSH_URL=http://localhost:3100/loki/api/v1/push
