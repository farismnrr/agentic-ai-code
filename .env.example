# Copy to .env and adjust per machine. .env is gitignored.

# Dev server port. 3000/3001/3004/3100 are taken on the original dev machine,
# so nuxt.config.ts defaults devServer.port to 3333.
NUXT_PORT=3333

# Dev server bind address. Unset = localhost only (safe default, keep it that way
# for anyone who just clones this).
#
# To reach the dev server from another device, bind to a specific interface —
# NOT 0.0.0.0, which also exposes it to whatever Wi-Fi/LAN you're on.
# Look up your own address; the one below is machine-specific.
#   tailscale ip -4
# NUXT_HOST=100.99.88.53

# Public runtime config — exposed to the browser.
# Maps to runtimeConfig.public.siteUrl in nuxt.config.ts.
NUXT_PUBLIC_SITE_URL=http://localhost:3333

# Private runtime config goes here without the PUBLIC_ segment, e.g.
# NUXT_API_SECRET=...
