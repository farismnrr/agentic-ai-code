# Copy to .env and fill in the values for your machine. .env is gitignored.

# Dev server port. 3000/3001/3004/3100 are taken on the original dev machine,
# so nuxt.config.ts defaults devServer.port to 3333.
NUXT_PORT=3333

# Dev server bind address. Unset = localhost only (safe default).
#
# To reach the dev server from another device, bind to a specific interface —
# NOT 0.0.0.0, which also exposes it to whatever Wi-Fi/LAN you're on.
#   tailscale ip -4
# NUXT_HOST=

# Public runtime config — exposed to the browser.
NUXT_PUBLIC_SITE_URL=http://localhost:3333

# ---------------------------------------------------------------------------
# Database (plan 005)
# ---------------------------------------------------------------------------
NUXT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Session (plan 005 — nuxt-auth-utils sealed cookie)
# ---------------------------------------------------------------------------
# Must be >= 32 characters. Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# ---------------------------------------------------------------------------
# SMTP (plan 005 — email verification + password reset)
# ---------------------------------------------------------------------------
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
NUXT_SMTP_SECURE=
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_FROM=

# ---------------------------------------------------------------------------
# OAuth (plan 005 phase 2 — Google + GitHub)
# ---------------------------------------------------------------------------
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=
