{
  "name": "ai-code",
  "version": "0.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:tools": "cargo build --release",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && bash scripts/install-git-hooks.sh",
    "lint:web": "eslint .",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --lib --bins --tests --all-features --locked -- -D warnings",
    "lint": "pnpm lint:web && pnpm lint:rust",
    "lint:fix": "eslint . --fix && cargo fmt --all",
    "typecheck:web": "nuxt prepare --dotenv .env.example && vue-tsc -p .nuxt/tsconfig.json --noEmit",
    "typecheck:rust": "RUSTFLAGS='-D warnings' cargo check --workspace --lib --bins --tests --all-features --locked",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:rust",
    "test:web": "node --experimental-strip-types --test test/unit/*.test.ts test/unit/*.test.mjs",
    "test:rust": "cargo test --workspace --lib --bins --tests --all-features --locked",
    "test": "pnpm test:web && pnpm test:rust",
    "guardrail": "bash scripts/guardrail.sh",
    "guardrail:nuxt": "bash scripts/guardrail.sh nuxt",
    "guardrail:rust": "bash scripts/guardrail.sh rust",
    "guardrail:all": "bash scripts/guardrail.sh all",
    "audit": "pnpm audit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "release:build": "bash ops/release/build-artifacts.sh",
    "release:publish": "bash ops/release/publish.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/google-vertex": "^4.0.177",
    "@ai-sdk/openai-compatible": "^3.0.25",
    "@ai-sdk/vue": "^4.0.55",
    "@comark/nuxt": "^0.6.0",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.92",
    "@langchain/anthropic": "^1.5.4",
    "@langchain/core": "^1.2.5",
    "@langchain/google-vertexai": "^2.2.0",
    "@langchain/openai": "^1.5.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nuxt/ui": "^4.10.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ai": "^7.0.56",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "eventsource-parser": "^3.1.0",
    "langchain": "^1.5.5",
    "nodemailer": "^9.0.4",
    "nuxt": "^4.5.1",
    "nuxt-auth-utils": "^0.5.30",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.4.2",
    "zod": "^4.4.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "^5.0.23",
    "@nuxt/eslint": "^1.16.0",
    "@types/nodemailer": "^8.0.1",
    "agentation-vue": "^0.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3",
    "vite-plugin-eslint2": "^5.3.0",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.18.0"
}
